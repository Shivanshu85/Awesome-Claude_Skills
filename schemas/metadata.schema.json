{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://awesome-claude-skills.org/schemas/metadata.schema.json",
  "title": "Awesome-Claude_Skills Metadata Schema",
  "description": "Machine-readable schema validating metadata.json for documented tools in Awesome-Claude_Skills.",
  "type": "object",
  "required": [
    "name",
    "slug",
    "description",
    "category",
    "tags",
    "difficulty",
    "license",
    "official",
    "official_repository",
    "supported_models",
    "supported_platforms",
    "supported_ides",
    "primary_benefit",
    "impact_ratings",
    "version",
    "status",
    "maintainer",
    "last_updated"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Official name of the tool or protocol."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Lowercase kebab-case directory slug matching tool name."
    },
    "description": {
      "type": "string",
      "maxLength": 280,
      "description": "Concise single-sentence summary for search and AI indexing."
    },
    "category": {
      "type": "string",
      "enum": [
        "memory",
        "context",
        "context-compression",
        "token-optimization",
        "prompt-engineering",
        "codebase-intelligence",
        "mcp",
        "developer-productivity",
        "agent-workflows",
        "security",
        "evaluation",
        "testing",
        "observability"
      ]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "difficulty": {
      "type": "string",
      "enum": ["Beginner", "Intermediate", "Advanced"]
    },
    "license": {
      "type": "string"
    },
    "official": {
      "type": "boolean"
    },
    "official_repository": {
      "type": "string",
      "format": "uri"
    },
    "official_documentation": {
      "type": "string",
      "format": "uri"
    },
    "supported_models": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supported_platforms": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supported_ides": {
      "type": "array",
      "items": { "type": "string" }
    },
    "primary_benefit": {
      "type": "string",
      "enum": [
        "Token Reduction",
        "Memory",
        "Context Retrieval",
        "Repository Analysis",
        "Prompt Optimisation",
        "MCP Integration",
        "Workflow Optimisation",
        "Security",
        "Planning"
      ]
    },
    "impact_ratings": {
      "type": "object",
      "required": [
        "token_saving",
        "context_quality",
        "developer_productivity",
        "reasoning_improvement",
        "setup_complexity"
      ],
      "properties": {
        "token_saving": { "type": "string", "enum": ["Low", "Medium", "High", "Very High", "N/A"] },
        "context_quality": { "type": "string", "enum": ["Low", "Medium", "High", "Very High", "N/A"] },
        "developer_productivity": { "type": "string", "enum": ["Low", "Medium", "High", "Very High", "N/A"] },
        "reasoning_improvement": { "type": "string", "enum": ["Low", "Medium", "High", "Very High", "N/A"] },
        "setup_complexity": { "type": "string", "enum": ["Low", "Medium", "High", "Very High", "N/A"] }
      }
    },
    "related_tools": {
      "type": "array",
      "items": { "type": "string" }
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["Active", "Limited Maintenance", "Archived"]
    },
    "maintainer": {
      "type": "string"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
